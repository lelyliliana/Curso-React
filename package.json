{
  "name": "curso-react",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:dominio": "node --test tests/*.test.js",
    "test:componentes": "vitest run",
    "test": "npm run test:dominio && npm run test:componentes",
    "check": "node scripts/verificar.js",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"features/**/*.{js,jsx}\" \"components/**/*.jsx\" \"unidad*/ejemplo/*.jsx\" \"ejemplos/**/*.jsx\""
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
